generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String   @id @default(cuid())
  customerName  String
  phone         String
  dateTime      DateTime
  guests        Int
  comboName     String
  comboPrice    Int
  hasDeposit    Boolean
  subtotal      Int
  discount      Int
  finalTotal    Int
  depositAmount Int
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}
